# Preserve original CAD bytes and keep generated STEP entity lists out of diffs.
Hardware/WM8978.3dshapes/*.step -text -diff
# Preserve upstream formatting in vendored code.
Firmware/third_party/** -whitespace
# Keep raw instrument output unchanged.
Documentation/Reports/**/*.log -whitespace
# Keep published firmware hashes independent of checkout line endings.
Firmware/releases/*.bin -text -diff
Firmware/releases/*.hex -text -diff
Firmware/releases/*.exe -text -diff
Firmware/releases/*.cwfw -text -diff
